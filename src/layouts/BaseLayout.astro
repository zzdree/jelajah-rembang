---
import BaseHead from '@/components/seo/BaseHead.astro';
import SiteHeader from '@/components/nav/SiteHeader.astro';
import SiteFooter from '@/components/footer/SiteFooter.astro';
import SkipLink from '@/components/nav/SkipLink.astro';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { HTML_LANG, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  translationKey?: string;
  collection?: string;
  slug?: string;
  type?: 'website' | 'article';
}

const { lang, title, description, ...head } = Astro.props;
const metaDescription = description ?? t('site.description', lang);
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-theme="light">
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={metaDescription}
      {...head}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink antialiased">
    <SkipLink lang={lang} />
    <SiteHeader lang={lang} />
    <main id="main" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script>
      // Pengendali reveal: elemen [data-reveal] muncul saat masuk viewport.
      // Berjalan di navigasi awal dan tiap perpindahan halaman (View Transitions).
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (reduced.matches) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

---
import BaseHead from '@/components/seo/BaseHead.astro';
import SiteHeader from '@/components/nav/SiteHeader.astro';
import SiteFooter from '@/components/footer/SiteFooter.astro';
import SkipLink from '@/components/nav/SkipLink.astro';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { HTML_LANG, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  translationKey?: string;
  collection?: string;
  slug?: string;
  type?: 'website' | 'article';
}

const { lang, title, description, ...head } = Astro.props;
const metaDescription = description ?? t('site.description', lang);
---

<!doctype html>
<!-- `data-theme` sengaja TIDAK di-SSR. View Transitions menyalin seluruh atribut
     <html> dari dokumen baru saat navigasi (swap-functions.js), jadi nilai statis
     akan menimpa pilihan tema pengguna. Skrip is:inline di BaseHead menetapkannya
     sebelum paint; ThemeToggle menyinkronkan ulang tiap `astro:page-load`. -->
<html lang={HTML_LANG[lang]}>
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={metaDescription}
      {...head}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink antialiased">
    <SkipLink lang={lang} />
    <SiteHeader lang={lang} />
    <main id="main" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script>
      // Pengendali reveal: elemen [data-reveal] muncul saat masuk viewport.
      // `astro:page-load` menyala SEKALI saat muat awal dan sekali tiap perpindahan
      // halaman, jadi cukup dengarkan itu; memanggil initReveal() langsung akan
      // membuat IntersectionObserver ganda memperebutkan elemen yang sama.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (reduced.matches) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);

      // Parallax halus hero: hanya ≥768px, mati di reduced-motion, listener
      // dibersihkan tiap perpindahan halaman agar tidak menumpuk.
      const small = window.matchMedia('(max-width: 767px)');
      let raf = 0;
      let onScroll: (() => void) | null = null;

      function initParallax() {
        const layer = document.querySelector<HTMLElement>('[data-parallax]');
        if (!layer || layer.dataset.parallaxOn || reduced.matches || small.matches) return;
        layer.dataset.parallaxOn = 'true';
        onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            raf = 0;
            const y = Math.min(window.scrollY, 600);
            layer.style.transform = `translate3d(0, ${y * 0.1}px, 0)`;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      function cleanupParallax() {
        if (onScroll) window.removeEventListener('scroll', onScroll);
        if (raf) cancelAnimationFrame(raf);
        document
          .querySelectorAll<HTMLElement>('[data-parallax]')
          .forEach((el) => delete el.dataset.parallaxOn);
        onScroll = null;
        raf = 0;
      }

      // `astro:page-load` menyala sekali saat muat awal dan tiap perpindahan halaman;
      // cukup itu (memanggil initParallax() langsung akan memasang listener ganda).
      document.addEventListener('astro:page-load', initParallax);
      document.addEventListener('astro:before-swap', cleanupParallax);
    </script>
  </body>
</html>

---
import { t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex items-center justify-center rounded-control border border-rule p-2 text-ink-soft transition-colors duration-150 hover:border-ink hover:text-ink"
  aria-label={t('theme.toggle', lang)}
  title={t('theme.toggle', lang)}
>
  <svg
    data-theme-icon="light"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    data-theme-icon="dark"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    style="display:none"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const KEY = 'rembang-theme';
  const root = document.documentElement;

  // Tema yang sedang berlaku. Dipegang sendiri (bukan dibaca dari DOM) karena
  // View Transitions menyalin atribut <html> dari dokumen baru yang selalu
  // "light", sehingga DOM bisa sempat tidak sejalan.
  let current: 'light' | 'dark' = 'light';

  function apply(theme: 'light' | 'dark') {
    current = theme;
    root.dataset.theme = theme;
    document.querySelectorAll<SVGElement>('[data-theme-icon]').forEach((el) => {
      (el as SVGElement & { style: CSSStyleDeclaration }).style.display =
        el.dataset.themeIcon === theme ? '' : 'none';
    });
  }

  function syncFromState() {
    // Sumber kebenaran saat navigasi: localStorage (lalu preferensi OS). Kita TIDAK
    // membaca root.dataset.theme karena View Transitions menimpanya sebelum
    // `astro:page-load` menyala.
    let theme: 'light' | 'dark';
    try {
      const stored = localStorage.getItem(KEY);
      theme =
        stored === 'dark' || stored === 'light'
          ? stored
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
    } catch {
      theme = 'light';
    }
    apply(theme);
  }

  function bind() {
    // Selaraskan dulu: setelah navigasi client-side DOM berganti, dan skrip inline
    // di BaseHead tidak berjalan ulang.
    syncFromState();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const next = current === 'dark' ? 'light' : 'dark';
        apply(next);
        try {
          localStorage.setItem(KEY, next);
        } catch {
          /* localStorage bisa diblokir — abaikan */
        }
      });
    });
  }

  // `astro:page-load` menyala pada muat awal dan tiap perpindahan halaman, jadi
  // listener dipasang ulang di sini; skrip modul Astro hanya berjalan sekali.
  bind();
  document.addEventListener('astro:page-load', bind);

  // View Transitions menyalin atribut <html> dari dokumen baru (yang selalu
  // "light"), sehingga tema harus dipulihkan tepat sebelum DOM berganti agar
  // tidak ada kedipan terang saat pengguna memilih gelap.
  document.addEventListener('astro:before-swap', () => {
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === 'dark' || stored === 'light') current = stored;
    } catch {
      /* localStorage bisa diblokir — biarkan tema apa adanya */
    }
  });
</script>

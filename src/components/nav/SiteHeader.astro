---
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localizePath, stripLocalePrefix, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const NAV: { key: Parameters<typeof t>[0]; path: string }[] = [
  { key: 'nav.sejarah', path: '/sejarah' },
  { key: 'nav.budaya', path: '/budaya' },
  { key: 'nav.kuliner', path: '/kuliner' },
  { key: 'nav.destinasi', path: '/destinasi' },
  { key: 'nav.profil', path: '/profil' },
  { key: 'nav.peta', path: '/peta' },
];

// URL halaman ini dalam bahasa lain (mempertahankan path).
const neutral = stripLocalePrefix(Astro.url.pathname);
const altHref = localizePath(neutral, lang === 'id' ? 'en' : 'id');
const current = neutral === '/' ? '/' : neutral.replace(/\/$/, '');
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-sm supports-[backdrop-filter]:bg-paper/75"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <!-- Identitas -->
    <a href={localizePath('/', lang)} class="group flex items-center gap-2.5" aria-label={t('site.name', lang)}>
      <svg
        width="30"
        height="30"
        viewBox="0 0 32 32"
        fill="none"
        stroke="var(--merah-lasem)"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="shrink-0"
      >
        <circle cx="16" cy="16" r="3.4"></circle>
        <path d="M16 4.5c0 3.6 4.5 4.4 4.5 7.9M16 27.5c0-3.6-4.5-4.4-4.5-7.9M4.5 16c3.6 0 4.4-4.5 7.9-4.5M27.5 16c-3.6 0-4.4 4.5-7.9 4.5"></path>
        <path
          d="M16 8.2a7.8 7.8 0 0 1 7.8 7.8M16 23.8A7.8 7.8 0 0 1 8.2 16"
          stroke="var(--soga)"
        ></path>
      </svg>
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-semibold tracking-tight text-ink"
          >{lang === 'id' ? 'Rembang' : 'Rembang'}</span
        >
        <span class="label-caps text-2xs text-ink-soft">{lang === 'id' ? 'Profil Daerah' : 'Regency Profile'}</span>
      </span>
    </a>

    <!-- Navigasi desktop -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label={t('nav.menu', lang)}>
      {
        NAV.map(({ key, path }) => {
          const href = localizePath(path, lang);
          const isActive = current === path || current.startsWith(`${path}/`);
          return (
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'rounded-control px-3 py-2 text-sm font-medium transition-colors duration-150',
                isActive ? 'text-merah' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {t(key, lang)}
            </a>
          );
        })
      }
    </nav>

    <!-- Kontrol -->
    <div class="flex items-center gap-2">
      <LangToggle lang={lang} altHref={altHref} />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        data-menu-toggle
        class="inline-flex items-center justify-center rounded-control border border-rule p-2 text-ink-soft transition-colors hover:border-soga hover:text-ink lg:hidden"
        aria-label={t('nav.open', lang)}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Navigasi seluler -->
  <nav
    id="mobile-menu"
    data-menu-panel
    hidden
    class="border-t border-rule bg-paper lg:hidden"
    aria-label={t('nav.menu', lang)}
  >
    <ul class="container-page grid grid-cols-2 gap-1 py-3">
      {
        NAV.map(({ key, path }) => {
          const href = localizePath(path, lang);
          const isActive = current === path || current.startsWith(`${path}/`);
          return (
            <li>
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'block rounded-control px-3 py-2.5 text-sm font-medium transition-colors',
                  isActive ? 'bg-paper-sunken text-merah' : 'text-ink-soft hover:bg-paper-sunken hover:text-ink',
                ]}
              >
                {t(key, lang)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  btn?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hidden;
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

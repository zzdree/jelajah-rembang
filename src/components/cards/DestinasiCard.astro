---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localizePath, t, type Lang } from '@/lib/i18n';
import { stripLang } from '@/lib/content';

interface Props {
  entry: CollectionEntry<'destinasi'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const { title, summary, cover, coverAlt, kind, kecamatan, coords } = entry.data;
const href = localizePath(`/destinasi/${stripLang(entry.id)}`, lang);

const KIND: Record<string, { id: string; en: string; ink: string }> = {
  pantai: { id: 'Pantai', en: 'Beach', ink: 'bg-merah' },
  museum: { id: 'Museum', en: 'Museum', ink: 'bg-soga' },
  religi: { id: 'Religi', en: 'Religious', ink: 'bg-indigo' },
  alam: { id: 'Alam', en: 'Nature', ink: 'bg-soga' },
  pulau: { id: 'Pulau', en: 'Island', ink: 'bg-merah' },
  embung: { id: 'Embung', en: 'Reservoir', ink: 'bg-indigo' },
  hutan: { id: 'Hutan', en: 'Forest', ink: 'bg-soga' },
};
const meta = KIND[kind] ?? { id: kind, en: kind, ink: 'bg-soga' };
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-card border border-rule bg-paper-raised transition-colors duration-200 hover:border-soga"
>
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-paper-sunken">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-soga">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 20l6-9 4 5 3-4 7 8H2Z" />
            <circle cx="16" cy="6.5" r="2.2" />
          </svg>
        </div>
      )
    }
    <span
      class:list={[
        'absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-pill px-2.5 py-1 text-xs font-semibold text-paper-raised',
        meta.ink,
      ]}
    >
      {meta[lang]}
      {coords && <span aria-hidden="true" title={t('destinasi.onMap', lang)}>◦</span>}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <span class="label-caps text-ink-soft">{kecamatan}</span>
    <h3 class="m-0 font-display text-xl font-semibold leading-snug text-ink">{title}</h3>
    <p class="m-0 flex-1 text-sm leading-relaxed text-ink-soft">{summary}</p>
    <span class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-merah">
      {t('common.readMore', lang)}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>

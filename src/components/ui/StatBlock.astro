---
interface Props {
  label: string;
  value: string;
  note?: string;
  /** Angka besar yang ditonjolkan. */
  emphasis?: boolean;
}
const { label, value, note, emphasis = false } = Astro.props;
---

<div class="flex flex-col gap-1.5 border-t border-rule pt-4">
  <span class="label-caps text-ink-soft">{label}</span>
  <span
    class:list={[
      'font-data tabular-nums leading-tight text-ink',
      emphasis ? 'text-2xl font-medium' : 'text-lg',
    ]}
  >
    {value}
  </span>
  {note && <span class="text-xs text-ink-soft">{note}</span>}
</div>

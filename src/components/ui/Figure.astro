---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Rasio tampilan; default mengikuti gambar. */
  ratio?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  src,
  alt,
  caption,
  ratio,
  widths = [400, 800, 1200],
  sizes = '(min-width: 1024px) 720px, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<figure class:list={['m-0', className]}>
  <div class:list={['overflow-hidden rounded-card bg-paper-sunken', ratio]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
      class="h-full w-full object-cover"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-2.5 text-sm leading-relaxed text-ink-soft">{caption}</figcaption>
    )
  }
</figure>

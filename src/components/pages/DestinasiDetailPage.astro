---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/nav/Breadcrumbs.astro';
import ArticleHeader from '@/components/ui/ArticleHeader.astro';
import Prose from '@/components/ui/Prose.astro';
import { localizePath, t, type Lang } from '@/lib/i18n';
import { stripLang } from '@/lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'destinasi'>;
}
const { lang, entry } = Astro.props;
const { title, summary, cover, coverAlt, kind, kecamatan, coords, access, hours, ticket, sources, updated } =
  entry.data;
const { Content } = await render(entry);

const KIND_LABEL: Record<string, { id: string; en: string }> = {
  pantai: { id: 'Pantai', en: 'Beach' },
  museum: { id: 'Museum', en: 'Museum' },
  religi: { id: 'Religi', en: 'Religious' },
  alam: { id: 'Alam', en: 'Nature' },
  pulau: { id: 'Pulau', en: 'Island' },
  embung: { id: 'Embung', en: 'Reservoir' },
  hutan: { id: 'Hutan', en: 'Forest' },
};

const meta: { label: string; value: string }[] = [
  { label: t('common.kecamatan', lang), value: kecamatan },
  { label: t('common.category', lang), value: KIND_LABEL[kind]?.[lang] ?? kind },
];
if (access) meta.push({ label: t('common.access', lang), value: access });
if (hours) meta.push({ label: t('common.hours', lang), value: hours });
if (ticket) meta.push({ label: t('common.ticket', lang), value: ticket });

const coordLabel = coords ? `${coords[0].toFixed(4)}, ${coords[1].toFixed(4)}` : undefined;
const updatedLabel =
  updated &&
  new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(updated);
---

<BaseLayout
  lang={lang}
  title={title}
  description={summary}
  type="article"
  collection="destinasi"
  slug={stripLang(entry.id)}
  translationKey={entry.data.translationKey}
>
  <div class="container-page pt-8">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t('nav.home', lang), href: localizePath('/', lang) },
        { label: t('destinasi.title', lang), href: localizePath('/destinasi', lang) },
        { label: title },
      ]}
    />
  </div>

  <ArticleHeader title={title} lead={summary} cover={cover} coverAlt={coverAlt} meta={meta} motif="kawung" />

  <div class="container-page py-section">
    <Prose dropcap>
      <Content />
    </Prose>

    {
      coordLabel && (
        <div class="measure-prose mt-10 rounded-card border border-rule bg-paper-sunken p-6">
          <h2 class="label-caps m-0 mb-3 text-ink-soft">{t('common.coords', lang)}</h2>
          <p class="data-figure m-0 text-ink">{coordLabel}</p>
          <a
            href={`https://www.openstreetmap.org/?mlat=${coords?.[0]}&mlon=${coords?.[1]}#map=14/${coords?.[0]}/${coords?.[1]}`}
            rel="noopener noreferrer"
            target="_blank"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-merah transition-colors hover:text-merah-deep"
          >
            OpenStreetMap
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        </div>
      )
    }

    {
      sources.length > 0 && (
        <aside class="measure-prose mt-14 border-t border-rule pt-6">
          <h2 class="label-caps m-0 mb-3 text-ink-soft">{t('common.source', lang)}</h2>
          <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
            {sources.map((s) => (
              <li class="text-sm text-ink-soft">{s}</li>
            ))}
          </ul>
          {updatedLabel && (
            <p class="mt-4 text-xs text-ink-soft">
              {t('common.updated', lang)}: {updatedLabel}
            </p>
          )}
        </aside>
      )
    }

    <div class="mt-12">
      <a
        href={localizePath('/destinasi', lang)}
        class="inline-flex items-center gap-2 text-sm font-semibold text-merah transition-colors hover:text-merah-deep"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        {t('common.backTo', lang)} {t('destinasi.title', lang)}
      </a>
    </div>
  </div>
</BaseLayout>

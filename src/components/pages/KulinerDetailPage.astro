---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/nav/Breadcrumbs.astro';
import ArticleHeader from '@/components/ui/ArticleHeader.astro';
import Prose from '@/components/ui/Prose.astro';
import { localizePath, t, type Lang } from '@/lib/i18n';
import { stripLang } from '@/lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'kuliner'>;
}
const { lang, entry } = Astro.props;
const { title, summary, cover, coverAlt, origin, type, ingredients, sources, updated } = entry.data;
const { Content } = await render(entry);

const TYPE_LABEL: Record<string, { id: string; en: string }> = {
  makanan: { id: 'Makanan', en: 'Dish' },
  minuman: { id: 'Minuman', en: 'Drink' },
  jajanan: { id: 'Jajanan', en: 'Snack' },
};

const meta = [
  { label: t('common.origin', lang), value: origin },
  { label: t('common.category', lang), value: TYPE_LABEL[type]?.[lang] ?? type },
];

const updatedLabel =
  updated &&
  new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(updated);
---

<BaseLayout
  lang={lang}
  title={title}
  description={summary}
  type="article"
  collection="kuliner"
  slug={stripLang(entry.id)}
  translationKey={entry.data.translationKey}
>
  <div class="container-page pt-8">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t('nav.home', lang), href: localizePath('/', lang) },
        { label: t('kuliner.title', lang), href: localizePath('/kuliner', lang) },
        { label: title },
      ]}
    />
  </div>

  <ArticleHeader title={title} lead={summary} cover={cover} coverAlt={coverAlt} meta={meta} motif="truntum" />

  <div class="container-page py-section">
    {
      ingredients.length > 0 && (
        <aside class="mb-12 rounded-card border border-rule bg-paper-sunken p-6 sm:p-7">
          <h2 class="label-caps m-0 mb-4 text-soga">{t('common.ingredients', lang)}</h2>
          <ul class="m-0 flex flex-wrap gap-2 p-0">
            {ingredients.map((ing) => (
              <li class="list-none rounded-pill border border-rule bg-paper-raised px-3 py-1.5 text-sm text-ink">
                {ing}
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <Prose>
      <Content />
    </Prose>

    {
      sources.length > 0 && (
        <aside class="measure-prose mt-14 border-t border-rule pt-6">
          <h2 class="label-caps m-0 mb-3 text-ink-soft">{t('common.source', lang)}</h2>
          <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
            {sources.map((s) => (
              <li class="text-sm text-ink-soft">{s}</li>
            ))}
          </ul>
          {updatedLabel && (
            <p class="mt-4 text-xs text-ink-soft">
              {t('common.updated', lang)}: {updatedLabel}
            </p>
          )}
        </aside>
      )
    }

    <div class="mt-12">
      <a
        href={localizePath('/kuliner', lang)}
        class="inline-flex items-center gap-2 text-sm font-semibold text-merah transition-colors hover:text-merah-deep"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        {t('common.backTo', lang)} {t('kuliner.title', lang)}
      </a>
    </div>
  </div>
</BaseLayout>

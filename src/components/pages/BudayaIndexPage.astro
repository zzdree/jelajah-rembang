---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/nav/Breadcrumbs.astro';
import BudayaCard from '@/components/cards/BudayaCard.astro';
import { getLocalized } from '@/lib/content';
import { localizePath, t, type Lang } from '@/lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const entries = await getLocalized('budaya', lang);

const INKS = ['merah', 'indigo', 'soga'] as const;
---

<BaseLayout
  lang={lang}
  title={t('budaya.title', lang)}
  description={t('budaya.lead', lang)}
  collection="budaya"
>
  <div class="container-page pt-8">
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t('nav.home', lang), href: localizePath('/', lang) },
        { label: t('budaya.title', lang) },
      ]}
    />
  </div>

  <header class="container-page pb-12 pt-4">
    <h1 class="m-0 max-w-[18ch] text-balance" data-reveal data-underline>{t('budaya.title', lang)}</h1>
    <p class="measure-prose mt-5 text-lg leading-relaxed text-ink-soft" data-reveal style="--i:1">{t('budaya.lead', lang)}</p>
  </header>

  <div class="container-page pb-section">
    <div class="grid gap-x-10 gap-y-12 md:grid-cols-2">
      {
        entries.map((entry, i) => (
          <div data-reveal style={`--i:${i % 2}`}>
            <BudayaCard entry={entry} lang={lang} ink={INKS[i % INKS.length]} />
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
